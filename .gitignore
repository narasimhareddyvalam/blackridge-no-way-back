# Godot-generated state. Keep .import and .uid sidecars tracked.
/game/.godot/
/game/**/*.translation

# Generated exports; keep the empty output directory in version control.
/builds/*
!/builds/.gitkeep

# Disposable development-tool output; tools and their documentation stay tracked.
/tools/.cache/
__pycache__/
*.pyc

# Local export/signing credentials. Non-secret export_presets.cfg stays tracked.
/game/export_credentials.cfg
*.p12
*.pfx
*.keystore

# Source Word documents stay outside the repository; documentation is Markdown.
*.[dD][oO][cC]
*.[dD][oO][cC][xX]

# Blender backups; keep original asset source files tracked.
*.blend[0-9]*

# macOS metadata.
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100/
.Trashes/

# Local editor state and temporary swap files.
.idea/
.vscode/
*.swp
*.swo
*~

# Raw Mixamo downloads (about 55 MB each, over the 25 MB limit). The slimmed game copies in
# game/features/characters/ are committed instead (decision C27).
/source_assets/mixamo/*.fbx

# Raw Sketchfab downloads (hundreds of MB). Each folder's README.md stays tracked.
/source_assets/sketchfab/*/*
!/source_assets/sketchfab/*/README.md

# The scratch home that scripts/run-test.sh gives Godot, so tests never touch the real save.
/.scratch-home/

# Keep the author prompt and decision log local for now.
/docs/AUTHOR_PROMPTS_AND_DECISIONS.md
