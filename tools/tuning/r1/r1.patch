diff --git a/game/features/vehicles/freight_van/van_particles.gd b/game/features/vehicles/freight_van/van_particles.gd
index 4efb3d1..00dc804 100644
--- a/game/features/vehicles/freight_van/van_particles.gd
+++ b/game/features/vehicles/freight_van/van_particles.gd
@@ -1,13 +1,25 @@
 extends Node3D
 ## The van's particle effects (CHANGE-BRIEF.md §2, §3, §5): the wiper flick, the roof spill and
 ## the exhaust vapour. This node places, starts and stops them from what the van does and never
-## writes the van's state. Each effect's look lives in its scene in game/effects/.
+## writes the van's state. Each effect's look lives in its scene in game/effects/. The flick is
+## simulated in the van's frame, so its drops leave the blade at the van's speed; at speed the
+## air over the glass pushes them up the windshield, and a collider on the glass stops any drop
+## that reaches it, so none flies into the cab.
 
 const WiperFlick = preload("res://effects/wiper_flick.tscn")
 const RoofSpill = preload("res://effects/roof_spill.tscn")
 const ExhaustVapour = preload("res://effects/exhaust_vapour.tscn")
 const FLICK_POOL := 2
-const FLICK_LIFE := 1.35
+## The air's push up the glass on a flick's drops: g × (speed / their terminal speed)², up to a
+## most, as drag on a drop grows with the square of the air's speed past it.
+const AIR_TERMINAL := {"BigDrops": 8.0, "FineSpray": 3.0}
+const AIR_MOST := {"BigDrops": 40.0, "FineSpray": 80.0}
+const GRAVITY := 9.8
+## The collider fills the cab behind the glass, no wider or taller than the glass, so nothing
+## stops in the air beside it or above the roof; its front face sits this far behind the glass,
+## so drops leaving the blade start outside it.
+const GLASS_BEHIND := 0.04
+const CAB_DEPTH := 2.0
 const SPILL_SPEED := 8.0
 const SPILL_DECELERATION := 6.0
 const SPILL_TICKS := 2
@@ -31,6 +43,7 @@ var spills_fired: int = 0
 var spills_ignored: int = 0
 var roof_refill: float = 0.0
 var exhaust: GPUParticles3D
+var glass_collider: GPUParticlesCollisionBox3D
 
 var _wiper: Node3D
 var _tip_reach: float = 0.0
@@ -44,9 +57,12 @@ var _last_speed: float = 0.0
 var _engine_time: float = 0.0
 var _ramp: float = 0.0
