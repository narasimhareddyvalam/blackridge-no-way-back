+## Read after the physics tick that set it and before the frame moves the body again.
+func _push(emitter_name: String) -> Vector3:
+	var flick: Node3D = _fx.flicks[0]
+	var process := (flick.get_node(emitter_name) as GPUParticles3D).process_material \
